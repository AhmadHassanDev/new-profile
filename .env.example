# Contact form delivery, through Resend (https://resend.com). Copy to .env.local and fill in.
RESEND_API_KEY=
# Where messages land
CONTACT_TO=ahmad.hassan.abdelmoaty@gmail.com
# Sender; must be on a domain verified in Resend. Leave unset to use Resend's test sender.
CONTACT_FROM=

# Overrides the site's public address (canonical URLs, Open Graph, the sitemap, robots.txt, structured
# data, llms.txt). Production builds default to https://www.ahmedhassan.dev; the dev server uses itself.
NEXT_PUBLIC_SITE_URL=
